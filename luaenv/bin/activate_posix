s=$(command -V deactivate_lua 2>&1)
if [ $? -eq 0 ]; then
    if [ "${s##*function*}" = '' ]; then
        deactivate_lua
    fi;
fi;

deactivate_lua () {
    if [ -x '/var/mnt/hdd/Dev/Balatro-balatrez-wow-wotlk/luaenv/bin/lua' ]; then
        PATH=`'/var/mnt/hdd/Dev/Balatro-balatrez-wow-wotlk/luaenv/bin/lua' '/var/mnt/hdd/Dev/Balatro-balatrez-wow-wotlk/luaenv/bin/get_deactivated_path.lua'`
        export PATH

        hash -r 2>/dev/null
    fi

    unset -f deactivate_lua
}

PATH='/var/mnt/hdd/Dev/Balatro-balatrez-wow-wotlk/luaenv/bin':"$PATH"
export PATH

hash -r 2>/dev/null
